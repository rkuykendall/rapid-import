{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.rkuykendall.rapidimport",
  "productName": "RapidImport",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RapidImport",
        "width": 1100,
        "height": 720,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility"
  },
  "version": "0.0.0"
}
